# Public site URL — used for canonical URLs, sitemap, OG metadata.
NEXT_PUBLIC_SITE_URL=https://ekalazim.com

# Notion blog (Phase 3). Create an internal integration at
# https://www.notion.so/my-integrations, then share your blog database with it.
# Until both are set, the blog renders an empty state (build stays green).
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_BLOG_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Contact form email (Phase 4) — Resend (https://resend.com).
# Until all three are set, submissions are logged to the server console
# instead of emailed (build/dev stay green without credentials).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=contact@ekalazim.com
CONTACT_RECIPIENT_EMAIL=haikalabakar@gmail.com

# Contact form rate limiting (Phase 4) — Upstash Redis
# (https://upstash.com). When unset, rate limiting fails open (no throttling).
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Error tracking (Phase 4) — Sentry (https://sentry.io).
# When unset, Sentry initialization no-ops.
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@xxxxxxx.ingest.sentry.io/xxxxxxx
